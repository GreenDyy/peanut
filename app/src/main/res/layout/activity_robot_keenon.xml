<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f5f5f5">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Robot Keenon - SDK Test Center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:gravity="center"
        android:padding="16dp"
        android:background="#ffffff"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- System Info Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System Information"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#E3F2FD"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_robot_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Robot Info"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_battery_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Battery"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_location_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Location"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_work_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Work Mode"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Navigation Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Navigation &amp; Movement"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#E8F5E8"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_move_forward"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Forward"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_move_backward"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Backward"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_turn_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Left"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_turn_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Right"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_stop_move"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stop"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_navigate_to"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Navigate"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_set_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Set Dest"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Voice & Audio Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice &amp; Audio"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#FFF3E0"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_speak_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Speak"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_start_listen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Listen"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_stop_listen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stop Listen"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Perception Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Perception &amp; Sensors"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#F3E5F5"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_face_detection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Face"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_object_detection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Object"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_distance_sensor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Distance"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Hardware Control Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hardware Control"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#FFEBEE"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_door_open"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Door Open"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_door_close"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Door Close"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_light_control"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Light"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Charger Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charger &amp; Power"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#E0F2F1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_go_charge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Go Charge"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_charge_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Map Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Map &amp; SLAM"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#F1F8E9"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_map_download"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Download"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_map_upload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_start_mapping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mapping"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <!-- Head Motor Control Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Head Motor Control"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#E1F5FE"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_head_up"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Head Up"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_head_down"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Head Down"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_head_center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Center"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_head_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Head Left"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_head_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Head Right"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_head_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Stop"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_head_nod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nod"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2" />

            </LinearLayout>

            <!-- Motor Control Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motor Control"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:padding="8dp"
                android:background="#FFF8E1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_motor_enable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_motor_disable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disable"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

                <Button
                    android:id="@+id/btn_motor_health"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Health"
                    android:textSize="12sp"
                    android:layout_margin="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Log Display -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Console Log"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:padding="8dp"
        android:background="#ECEFF1" />

    <ScrollView
        android:id="@+id/sv_log"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#ffffff"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Robot Keenon ready for testing...\n"
            android:textSize="12sp"
            android:textColor="#555"
            android:fontFamily="monospace" />

    </ScrollView>

</LinearLayout>
