<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    tools:context=".test.TestNavigationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Navigation Component"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Khu vực kết nối -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#e8f5e8"
            android:padding="8dp">

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kết nối"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#4CAF50" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngắt kết nối"
                android:backgroundTint="#F44336" />
        </LinearLayout>

        <!-- Khu vực thông tin bản đồ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="#e3f2fd"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin bản đồ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_get_map_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Map List"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#2196F3"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_get_map_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Map Data"
                    android:backgroundTint="#2196F3"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Khu vực điều hướng cơ bản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="#fff3e0"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điều hướng cơ bản"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_get_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vị trí hiện tại"
                    android:backgroundTint="#FF9800"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>





        <!-- Khu vực Auto Charge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="#e8f5e8"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Charge"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/btn_auto_charge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Charge"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#4CAF50"
                    android:enabled="false" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_manual_charge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual Charge"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FF9800"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_cancel_charge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel Charge"
                    android:backgroundTint="#F44336"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Khu vực SdkHelper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="#fff8e1"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SdkHelper Navigation"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/btn_set_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set Speed"
                    android:backgroundTint="#4CAF50"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_query_nearest_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearest Target"
                    android:backgroundTint="#2196F3"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_get_all_targets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get All Targets"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#607D8B"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_get_guide_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get Guide Info"
                    android:backgroundTint="#795548"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_pause_navigation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FF9800"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_continue_navigation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continue"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#4CAF50"
                    android:enabled="false" />

                <Button
                    android:id="@+id/btn_stop_navigation_sdk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop Nav"
                    android:backgroundTint="#F44336"
                    android:enabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_get_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Get Zones"
                    android:backgroundTint="#FF5722"
                    android:enabled="false" />
            </LinearLayout>

            <!-- Khu vực nhập Target ID và thực hiện navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target ID:"
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_target_id"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:hint="Nhập ID"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btn_execute_navigation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thực hiện Navigation"
                    android:backgroundTint="#4CAF50"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Khu vực hiển thị log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhật ký hoạt động:"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Khu vực log với chiều cao cố định -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#f0f0f0"
            android:padding="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="🚀 TestNavigationActivity đã khởi tạo\n📱 Đang chuẩn bị kết nối đến robot..."
                    android:textColor="#000000"
                    android:fontFamily="monospace" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
